<Window x:Class="zadanie3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Планировщик задач" Height="620" Width="780"
        MinWidth="720" MinHeight="560"
        Background="#F4F5F7"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Стили для TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="4,4"/>
            <Setter Property="Width" Value="300"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#9CA3AF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#0EA5E9"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стили для ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="4,4"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Стили для DatePicker -->
        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="4,4"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Стиль для меток -->
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Width" Value="90"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#374151"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="140"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Уведомления о сроках -->
        <Border x:Name="warningBorder" Grid.Row="0" Visibility="Collapsed" Margin="0,0,0,10"
                Padding="12" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8">
            <TextBlock x:Name="warningText" TextWrapping="Wrap" Foreground="#92400E" FontWeight="Medium"/>
        </Border>

        <!-- Таблица задач -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="4" Margin="0,0,0,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.05" Color="Black"/>
            </Border.Effect>
            <DataGrid x:Name="grid" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      SelectionMode="Single"
                      SelectionChanged="Grid_SelectionChanged"
                      Background="Transparent"
                      BorderBrush="Transparent"
                      RowHeight="28"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F3F4F6">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Просрочена">
                                <Setter Property="Foreground" Value="#EF4444"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Выполнена">
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Задача" Binding="{Binding Title}" Width="2*"/>
                    <DataGridTextColumn Header="Приоритет" Binding="{Binding PriorityText}" Width="*"/>
                    <DataGridTextColumn Header="Срок" Binding="{Binding DueText}" Width="*"/>
                    <DataGridTextColumn Header="Прогресс, %" Binding="{Binding Progress}" Width="*"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Поля ввода и кнопки -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.05" Color="Black"/>
            </Border.Effect>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="Название" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="titleBox" Width="300"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="Приоритет" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="priorityBox" SelectedIndex="1">
                        <ComboBoxItem Content="Низкий"/>
                        <ComboBoxItem Content="Средний"/>
                        <ComboBoxItem Content="Высокий"/>
                    </ComboBox>
                    <TextBlock Text="Срок" Margin="20,0,8,0" VerticalAlignment="Center" FontWeight="Medium" Foreground="#374151"/>
                    <DatePicker x:Name="datePicker"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="Прогресс" Style="{StaticResource FieldLabel}"/>
                    <Slider x:Name="progressSlider" Width="280" Margin="4,8" Minimum="0" Maximum="100"
                            TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Value, ElementName=progressSlider, StringFormat={}{0}%}"
                               Width="50" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#4B5563"/>
                </StackPanel>

                <!-- Панель кнопок с красивыми цветами -->
                <StackPanel Orientation="Horizontal" Margin="90,6,0,0">
                    <!-- Добавить -->
                    <Button Content="Добавить" Click="Add_Click" Background="#0D9488" Foreground="White" FontWeight="SemiBold" Cursor="Hand" Width="110" Height="32" Margin="0,0,6,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#0F766E"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#115E59"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Изменить -->
                    <Button Content="Изменить" Click="Update_Click" Background="#2563EB" Foreground="White" FontWeight="SemiBold" Cursor="Hand" Width="110" Height="32" Margin="0,0,6,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1D4ED8"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#1E40AF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Удалить -->
                    <Button Content="Удалить" Click="Delete_Click" Background="#4B5563" Foreground="White" FontWeight="SemiBold" Cursor="Hand" Width="110" Height="32">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#374151"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#1F2937"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
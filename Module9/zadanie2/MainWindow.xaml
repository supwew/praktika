<Window x:Class="zadanie2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление задачами проекта" Height="500" Width="680"
        MinWidth="580" MinHeight="420"
        Background="#F4F5F7"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Компактные стили для полей ввода -->
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="3,2"/>
            <Setter Property="Width" Value="130"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#9CA3AF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#0EA5E9"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="3,2"/>
            <Setter Property="Width" Value="130"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="3,2"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="#0D9488"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0F766E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#115E59"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="RowHeight" Value="26"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F3F4F6"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0,2,0"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#374151"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Margin="6,2" FontWeight="Medium" FontSize="12"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <TabControl Margin="8" Background="Transparent" BorderBrush="#E5E7EB">

        <!-- Сотрудники -->
        <TabItem Header="Сотрудники">
            <Border Background="White" CornerRadius="0,6,6,6" Padding="8">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Background="#F9FAFB" CornerRadius="5" Padding="6" Margin="0,6,0,0">
                        <WrapPanel>
                            <TextBlock Text="Имя" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="empNameBox"/>
                            <TextBlock Text="Должность" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="empPositionBox"/>
                            <Button Content="Добавить" Click="EmpAdd_Click" Width="61"/>
                            <Button Content="Изменить" Click="EmpUpdate_Click" Background="#2563EB" Width="68"/>
                            <Button Content="Удалить" Click="EmpDelete_Click" Background="#4B5563" Width="57"/>
                        </WrapPanel>
                    </Border>
                    <DataGrid x:Name="empGrid" SelectionChanged="EmpGrid_SelectionChanged"/>
                </DockPanel>
            </Border>
        </TabItem>

        <!-- Проекты -->
        <TabItem Header="Проекты">
            <Border Background="White" CornerRadius="0,6,6,6" Padding="8">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Background="#F9FAFB" CornerRadius="5" Padding="6" Margin="0,6,0,0">
                        <WrapPanel>
                            <TextBlock Text="Название" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="projNameBox"/>
                            <TextBlock Text="Описание" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="projDescBox"/>
                            <Button Content="Добавить" Click="ProjAdd_Click"/>
                            <Button Content="Изменить" Click="ProjUpdate_Click" Background="#2563EB"/>
                            <Button Content="Удалить" Click="ProjDelete_Click" Background="#4B5563"/>
                        </WrapPanel>
                    </Border>
                    <DataGrid x:Name="projGrid" SelectionChanged="ProjGrid_SelectionChanged"/>
                </DockPanel>
            </Border>
        </TabItem>

        <!-- Задачи -->
        <TabItem Header="Задачи">
            <Border Background="White" CornerRadius="0,6,6,6" Padding="8">
                <DockPanel>
                    <ScrollViewer DockPanel.Dock="Bottom" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0">
                        <StackPanel>
                            <Border Background="#F9FAFB" CornerRadius="5" Padding="6" Margin="0,0,0,4">
                                <WrapPanel>
                                    <TextBlock Text="Задача" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="taskTitleBox" Width="120"/>
                                    <TextBlock Text="Проект" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="projectBox" DisplayMemberPath="Проект" SelectedValuePath="Номер" Width="120"/>
                                    <Button Content="Добавить" Click="TaskAdd_Click" Width="61"/>
                                    <Button Content="Изменить" Click="TaskUpdate_Click" Background="#2563EB" Width="62"/>
                                    <Button Content="Удалить" Click="TaskDelete_Click" Background="#4B5563" Width="55"/>
                                </WrapPanel>
                            </Border>

                            <Border Background="#F9FAFB" CornerRadius="5" Padding="6" Margin="0,0,0,4">
                                <WrapPanel>
                                    <TextBlock Text="Исполнитель" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="employeeBox" DisplayMemberPath="Имя" SelectedValuePath="Номер" Width="160"/>
                                    <Button Content="Назначить" Click="Assign_Click" Width="65"/>
                                    <Button Content="Снять" Click="Unassign_Click" Background="#D97706"/>
                                </WrapPanel>
                            </Border>

                            <Border Background="#F9FAFB" CornerRadius="5" Padding="6">
                                <WrapPanel VerticalAlignment="Center">
                                    <TextBlock Text="Прогресс" Style="{StaticResource FieldLabel}"/>
                                    <Slider x:Name="progressSlider" Width="140" Margin="4,0" Minimum="0" Maximum="100"
                                            TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Value, ElementName=progressSlider, StringFormat={}{0}%}"
                                               Width="35" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#4B5563"/>
                                    <Button Content="Установить" Click="Progress_Click"/>
                                </WrapPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <DataGrid x:Name="taskGrid" SelectionChanged="TaskGrid_SelectionChanged"/>
                </DockPanel>
            </Border>
        </TabItem>

        <!-- Отчет -->
        <TabItem Header="Отчет">
            <Border Background="White" CornerRadius="0,6,6,6" Padding="8">
                <DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Button Content="📁 Сформировать отчет" HorizontalAlignment="Left" Click="Report_Click" Margin="0,0,0,8"/>
                            <TextBlock Text="Проекты" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,2"/>
                            <DataGrid x:Name="reportProjectsGrid" Height="120" Margin="0,0,0,8"/>
                            <TextBlock Text="Задачи по статусам" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,2"/>
                            <DataGrid x:Name="reportStatusGrid" Height="120"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </TabItem>
    </TabControl>
</Window>
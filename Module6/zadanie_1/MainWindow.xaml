<Window x:Class="zadanie_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сотрудники" Height="500" Width="600">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Width" Value="250"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Width" Value="100"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="10">
        <!-- Поля ввода и кнопки -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="ФИО" Width="100" VerticalAlignment="Center"/>
                <TextBox x:Name="nameBox"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Должность" Width="100" VerticalAlignment="Center"/>
                <TextBox x:Name="positionBox"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Зарплата" Width="100" VerticalAlignment="Center"/>
                <TextBox x:Name="salaryBox"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Дата приема" Width="100" VerticalAlignment="Center"/>
                <DatePicker x:Name="datePicker" Width="150" Margin="3"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Content="Добавить" Click="Add_Click"/>
                <Button Content="Изменить" Click="Update_Click"/>
                <Button Content="Удалить" Click="Delete_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Таблица сотрудников -->
        <DataGrid x:Name="grid" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionChanged="Grid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="2*"/>
                <DataGridTextColumn Header="Должность" Binding="{Binding Position}" Width="*"/>
                <DataGridTextColumn Header="Зарплата" Binding="{Binding Salary}" Width="*"/>
                <DataGridTextColumn Header="Дата приема" Binding="{Binding HireDate}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
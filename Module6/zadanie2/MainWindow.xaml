<Window x:Class="zadanie2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задачи" Height="450" Width="600">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Width" Value="300"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Width" Value="100"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="10">
        <!-- Поля ввода и кнопки -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Название" Width="90" VerticalAlignment="Center"/>
                <TextBox x:Name="titleBox"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Описание" Width="90" VerticalAlignment="Center"/>
                <TextBox x:Name="descBox"/>
            </StackPanel>
            <CheckBox x:Name="doneBox" Content="Выполнена" Margin="3"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Добавить" Click="Add_Click"/>
                <Button Content="Обновить" Click="Update_Click"/>
                <Button Content="Удалить" Click="Delete_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Таблица задач -->
        <DataGrid x:Name="grid" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionChanged="Grid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="2*"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="2*"/>
                <DataGridTextColumn Header="Выполнена" Binding="{Binding Status}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
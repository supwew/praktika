<Window x:Class="zadanie3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Библиотека" Height="450" Width="780">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Width" Value="200"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Width" Value="120"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="10">
        <!-- Поиск -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <TextBlock Text="Поиск" VerticalAlignment="Center" Margin="3"/>
            <TextBox x:Name="searchBox"/>
            <Button Content="Найти" Click="Search_Click"/>
            <Button Content="Показать все" Click="ShowAll_Click"/>
        </StackPanel>

        <!-- Аренда и возврат -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
            <TextBlock Text="Читатель" VerticalAlignment="Center" Margin="3"/>
            <TextBox x:Name="readerBox"/>
            <Button Content="Взять в аренду" Click="Rent_Click"/>
            <Button Content="Вернуть книгу" Click="Return_Click"/>
        </StackPanel>

        <!-- Таблица книг -->
        <DataGrid x:Name="grid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="2*"/>
                <DataGridTextColumn Header="Автор" Binding="{Binding Author}" Width="1.5*"/>
                <DataGridTextColumn Header="Год" Binding="{Binding Year}" Width="0.6*"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*"/>
                <DataGridTextColumn Header="Читатель" Binding="{Binding Reader}" Width="*"/>
                <DataGridTextColumn Header="Дата аренды" Binding="{Binding RentDate}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
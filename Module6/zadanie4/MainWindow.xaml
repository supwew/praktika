<Window x:Class="zadanie4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учет финансов" Height="500" Width="620">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Width" Value="200"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Width" Value="100"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="10">
        <!-- Итоги -->
        <TextBlock x:Name="summaryText" DockPanel.Dock="Top" FontSize="16" FontWeight="Bold" Margin="3,0,0,10"/>

        <!-- Поля ввода и кнопки -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Тип" Width="90" VerticalAlignment="Center"/>
                <ComboBox x:Name="typeBox" Width="200" Margin="3" SelectedIndex="0">
                    <ComboBoxItem Content="Доход"/>
                    <ComboBoxItem Content="Расход"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Категория" Width="90" VerticalAlignment="Center"/>
                <TextBox x:Name="categoryBox"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Сумма" Width="90" VerticalAlignment="Center"/>
                <TextBox x:Name="amountBox"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Дата" Width="90" VerticalAlignment="Center"/>
                <DatePicker x:Name="datePicker" Width="150" Margin="3"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Content="Добавить" Click="Add_Click"/>
                <Button Content="Изменить" Click="Update_Click"/>
                <Button Content="Удалить" Click="Delete_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Таблица записей -->
        <DataGrid x:Name="grid" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionChanged="Grid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="*"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="2*"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Amount}" Width="*"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding RecordDate}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
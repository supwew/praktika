<Window x:Class="Contacts.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Контакты" Height="540" Width="700">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Width" Value="280"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Width" Value="110"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="10">
        <!-- Поиск по имени -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <TextBlock Text="Поиск по имени" VerticalAlignment="Center" Margin="3"/>
            <TextBox x:Name="searchBox" TextChanged="Search_TextChanged"/>
        </StackPanel>

        <!-- Поля ввода, кнопки и информация о выбранном контакте -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Тип" Width="90" VerticalAlignment="Center"/>
                <ComboBox x:Name="typeBox" Width="280" Margin="3" SelectedIndex="0" SelectionChanged="Type_SelectionChanged">
                    <ComboBoxItem Content="Личный"/>
                    <ComboBoxItem Content="Рабочий"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Имя" Width="90" VerticalAlignment="Center"/>
                <TextBox x:Name="nameBox"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Телефон" Width="90" VerticalAlignment="Center"/>
                <TextBox x:Name="phoneBox"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Email" Width="90" VerticalAlignment="Center"/>
                <TextBox x:Name="emailBox"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="detailsLabel" Text="Заметка" Width="90" VerticalAlignment="Center"/>
                <TextBox x:Name="detailsBox"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Content="Добавить" Click="Add_Click"/>
                <Button Content="Изменить" Click="Update_Click"/>
                <Button Content="Удалить" Click="Delete_Click"/>
            </StackPanel>
            <TextBlock x:Name="infoText" Margin="3,8,3,0" TextWrapping="Wrap" FontStyle="Italic"/>
        </StackPanel>

        <!-- Таблица контактов -->
        <DataGrid x:Name="grid" Margin="0,10,0,0" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionChanged="Grid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="1.5*"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="*"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.5*"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="0.8*"/>
                <DataGridTextColumn Header="Заметка / компания" Binding="{Binding Details}" Width="1.5*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
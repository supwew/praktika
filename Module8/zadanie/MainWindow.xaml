<Window x:Class="Contacts.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Контакты" Height="650" Width="760"
        MinWidth="740" MinHeight="620"
        Background="#F4F5F7"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="4,3"/>
            <Setter Property="Width" Value="300"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#9CA3AF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#0EA5E9"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="4,3"/>
            <Setter Property="Width" Value="300"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="4,6,4,2"/>
            <Setter Property="Width" Value="115"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Width" Value="110"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#374151"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="120"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Поиск -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔍 Поиск по имени" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold" Foreground="#4B5563"/>
                <TextBox x:Name="searchBox" TextChanged="Search_TextChanged" Width="400"/>
            </StackPanel>
        </Border>

        <!-- Таблица -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="4" Margin="0,0,0,10">
            <DataGrid x:Name="grid" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      SelectionMode="Single" 
                      SelectionChanged="Grid_SelectionChanged"
                      Background="Transparent"
                      BorderBrush="Transparent"
                      RowHeight="28"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F3F4F6">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="⭐" Width="40">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <!-- По умолчанию пусто -->
                                            <Setter Property="Text" Value=""/>
                                            <Style.Triggers>
                                                <!-- Если IsFavorite == True, показываем звёздочку -->
                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                    <Setter Property="Text" Value="⭐"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="1.5*"/>
                    <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="*"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.5*"/>
                    <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="0.8*"/>
                    <DataGridTextColumn Header="Заметка / компания" Binding="{Binding Details}" Width="1.5*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Форма ввода -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Тип" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="typeBox" SelectedIndex="0" SelectionChanged="Type_SelectionChanged">
                        <ComboBoxItem Content="Личный"/>
                        <ComboBoxItem Content="Рабочий"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Имя" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="nameBox"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Телефон" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="phoneBox"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="emailBox"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="detailsLabel" Text="Заметка" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="detailsBox"/>
                </StackPanel>

                <!-- Чекбокс Избранное -->
                <StackPanel Orientation="Horizontal" Margin="114,6,0,6">
                    <CheckBox x:Name="favoriteCheck" Content="Добавить в избранное ⭐" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Панель кнопок управления -->
                <StackPanel Orientation="Horizontal" Margin="110,4,0,0">
                    <Button Content="Добавить" Click="Add_Click" Background="#0D9488">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#0F766E"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#115E59"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Content="Изменить" Click="Update_Click" Background="#2563EB">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1D4ED8"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#1E40AF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Content="Удалить" Click="Delete_Click" Background="#4B5563">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#374151"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#1F2937"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <TextBlock x:Name="infoText" Margin="0,6,0,0" TextWrapping="Wrap" FontStyle="Italic" Foreground="#6B7280"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>